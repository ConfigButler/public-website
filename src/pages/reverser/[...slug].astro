---
import Layout from '../../layouts/Layout.astro';
import { docs, render, route, version, repo, ref } from '../../lib/reverser';

export function getStaticPaths() {
	return docs.map((d) => ({ params: { slug: d.slug }, props: { src: d.src } }));
}

const { src } = Astro.props;
const { html, title, description, toc, source } = await render(src);
const here = route(Astro.params.slug);
---
<Layout
	title={src === 'README.md' ? 'GitOps Reverser · ConfigButler' : `${title} · GitOps Reverser`}
	description={description}
>
	<div class="docbar">
		<div class="wrap docbar-row">
			<span class="kicker"><span class="dot"></span>gitops reverser · open source</span>
			<nav class="doctabs" aria-label="GitOps Reverser documentation">
				{docs.map((d) => (
					<a href={route(d.slug)} aria-current={route(d.slug) === here ? 'page' : undefined}>{d.nav}</a>
				))}
			</nav>
			<a class="docsrc mono" href={source} target="_blank" rel="noopener" title={`Pinned at ${ref}`}>
				view source @ {version} ↗
			</a>
		</div>
	</div>

	<div class="wrap doc-grid">
		{toc.length > 2 && (
			<aside class="doc-toc">
				<details id="doc-toc">
					<summary class="eyebrow">On this page</summary>
					<ol>
						{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
					</ol>
				</details>
			</aside>
		)}
		<article class="doc" set:html={html} />
	</div>

	<div class="wrap doc-foot mono">
		Rendered from <a href={`${repo}/tree/${ref}`} target="_blank" rel="noopener">ConfigButler/gitops-reverser @ {version}</a>.
		Spotted something wrong? <a href={source} target="_blank" rel="noopener">Edit it upstream.</a>
	</div>
</Layout>

<script>
	// Contents list: open beside the doc on desktop, collapsed above it on mobile.
	const toc = document.getElementById('doc-toc') as HTMLDetailsElement | null;
	if (toc) toc.open = matchMedia('(min-width: 961px)').matches;
</script>

<style>
	.docbar { border-bottom: 1px solid var(--line); background: var(--paper-3); }
	.docbar-row { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; padding-top: 14px; padding-bottom: 14px; }
	.doctabs { display: flex; gap: 4px; flex-wrap: wrap; }
	.doctabs a {
		font-family: var(--mono); font-size: 12.5px; color: var(--ink-3);
		padding: 6px 12px; border-radius: 999px; border: 1px solid transparent;
	}
	.doctabs a:hover { color: var(--ink); border-color: var(--line); }
	.doctabs a[aria-current='page'] { color: var(--paper); background: var(--ink); }
	.docsrc { margin-left: auto; font-size: 11.5px; color: var(--ink-3); }
	.docsrc:hover { color: var(--brass-deep); }

	.doc-grid {
		display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 56px;
		padding-top: 48px; padding-bottom: 64px; align-items: start;
	}
	.doc-grid:not(:has(.doc-toc)) { grid-template-columns: minmax(0, 1fr); }
	.doc-toc { position: sticky; top: 88px; max-height: calc(100vh - 110px); overflow: auto; font-size: 13px; }
	.doc-toc summary { cursor: pointer; list-style: none; margin-bottom: 10px; }
	.doc-toc summary::-webkit-details-marker { display: none; }
	.doc-toc summary::after { content: ' +'; }
	.doc-toc details[open] summary::after { content: ' −'; }
	.doc-toc ol { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--line); }
	.doc-toc li a { display: block; padding: 4px 0 4px 14px; color: var(--ink-3); line-height: 1.35; }
	.doc-toc li a:hover { color: var(--ink); }

	.doc-foot { font-size: 11.5px; color: var(--ink-3); padding-bottom: 56px; }
	.doc-foot a { color: var(--ink-2); border-bottom: 1px solid var(--line); }

	@media (max-width: 960px) {
		.doc-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-top: 28px; }
		.doc-toc { position: static; max-height: none; border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; background: var(--paper-3); }
		.doc-toc summary { margin-bottom: 0; }
		.doc-toc details[open] summary { margin-bottom: 10px; }
		.docsrc { margin-left: 0; }
	}

	/* Upstream Markdown, so style elements, not classes. */
	.doc { max-width: 820px; color: var(--ink-2); font-size: 16px; line-height: 1.68; overflow-wrap: anywhere; }
	.doc :global(> * + *) { margin-top: 1rem; }
	.doc :global(h1) { font-size: clamp(32px, 4vw, 44px); font-weight: 600; letter-spacing: -.03em; line-height: 1.1; color: var(--ink); margin-top: 1.2rem; }
	.doc :global(h2) { font-size: 26px; font-weight: 600; letter-spacing: -.02em; color: var(--ink); margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid var(--line); }
	.doc :global(h3) { font-size: 19px; font-weight: 600; letter-spacing: -.015em; color: var(--ink); margin-top: 2.2rem; }
	.doc :global(h4), .doc :global(h5) { font-size: 16px; font-weight: 600; color: var(--ink); margin-top: 1.8rem; }
	.doc :global(:is(h1, h2, h3, h4, h5)) { scroll-margin-top: 90px; }
	.doc :global(a) { color: var(--ink); border-bottom: 1px solid var(--brass); }
	.doc :global(a:hover) { color: var(--brass-deep); }
	.doc :global(strong) { color: var(--ink); font-weight: 600; }
	.doc :global(:is(ul, ol)) { padding-left: 1.3rem; }
	.doc :global(li + li) { margin-top: .35rem; }
	.doc :global(li > :is(ul, ol)) { margin-top: .35rem; }
	.doc :global(:not(pre) > code) {
		font-family: var(--mono); font-size: .86em; background: var(--paper-2);
		padding: 1px 5px; border-radius: 4px; color: var(--ink);
	}
	.doc :global(pre) {
		font-family: var(--mono); font-size: 13px; line-height: 1.6;
		background: var(--ink) !important; border-radius: 10px; padding: 16px 18px; overflow-x: auto;
	}
	.doc :global(pre code) { overflow-wrap: normal; }
	.doc :global(blockquote) { border-left: 3px solid var(--brass); padding: 4px 0 4px 16px; color: var(--ink-3); }
	.doc :global(img) { max-width: 100%; height: auto; }
	.doc :global(p > img), .doc :global(div > img), .doc :global(p > a > img) { display: inline-block; vertical-align: middle; }
	.doc :global(p:has(> img:only-child)) img, .doc :global(div[align] img) {
		display: block; border: 1px solid var(--line); border-radius: 10px; background: #fff; padding: 8px;
	}
	.doc :global(a:has(> img)) { border-bottom: 0; }
	.doc :global(table) { display: block; overflow-x: auto; border-collapse: collapse; font-size: 14px; line-height: 1.5; }
	.doc :global(:is(th, td)) { border: 1px solid var(--line); padding: 8px 12px; text-align: left; vertical-align: top; }
	.doc :global(th) { background: var(--paper-2); color: var(--ink); font-weight: 600; }
	.doc :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.4rem 0; }
</style>
