---
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';

const { pathname } = Astro.url;
const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
const cur = (href: string) => (isActive(href) ? 'page' : undefined);
---
<header class="nav">
	<div class="wrap row">
		<a class="brand" href="/" aria-label="configbutler.ai home">
			<span class="mk"><Mark size={30} /></span>
			<Wordmark size={17} />
		</a>

		<nav class="links" id="site-nav" aria-label="Primary">
			<a class="lk lk--apps" href="/applications" aria-current={cur('/applications')}><span class="d"></span>apps</a>
			<a class="lk lk--gitops" href="/gitops" aria-current={cur('/gitops')}><span class="d"></span>gitops</a>
			<span class="nav-div" aria-hidden="true"></span>
			<a href="/technology" aria-current={cur('/technology')}>tech</a>
			<a href="/open-source" aria-current={cur('/open-source')}>open source</a>
			<a href="/about" aria-current={cur('/about')}>about</a>
		</nav>

		<div class="right">
			<a class="cta" href="/about#contact">
				<span class="d"></span><span class="label-full">talk to&nbsp;</span>simon
			</a>
			<button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
			</button>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const nav = document.getElementById('site-nav');
	toggle?.addEventListener('click', () => {
		const open = nav?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', String(!!open));
	});
	nav?.querySelectorAll('a').forEach((a) =>
		a.addEventListener('click', () => {
			nav.classList.remove('open');
			toggle?.setAttribute('aria-expanded', 'false');
		})
	);
</script>
