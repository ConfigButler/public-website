---
// ConfigButler dome mark. boxed = brass-lined dome on forest-ink tile.
interface Props { size?: number; boxed?: boolean; class?: string; }
const { size = 30, boxed = true, class: cls = '' } = Astro.props;
const stroke = boxed ? '#f3ead7' : '#0f1e1a';
---
<svg width={size} height={size} viewBox="0 0 100 100" class={cls} role="img" aria-label="ConfigButler" style="display:block">
	{boxed && <rect width="100" height="100" rx="14" fill="#0f1e1a" />}
	<path d="M 23 60 A 27 25 0 0 1 77 60" fill="none" stroke={stroke} stroke-width="7.5" stroke-linecap="round" />
	<circle cx="50" cy="27" r="4.4" fill="#c4a35a" />
	<line x1="16" y1="66" x2="84" y2="66" stroke={stroke} stroke-width="7.5" stroke-linecap="round" />
	<line x1="32" y1="74" x2="68" y2="74" stroke={stroke} stroke-width="3" stroke-linecap="round" opacity="0.55" />
</svg>
