---
// Line-icon component. Glyph geometry is NOT stored here — it is read at build time
// from the installed open-source packages (Lucide/ISC, Feather/MIT) via src/lib/icons.ts.
// This component only handles sizing and stroke styling. See public NOTICE for licenses.
import { icons } from '../lib/icons';
interface Props { name: string; size?: number; class?: string; }
const { name, size = 18, class: cls = '' } = Astro.props;
const inner = icons[name] ?? '';
---
<svg
	width={size} height={size} viewBox="0 0 24 24" class={cls}
	fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
	aria-hidden="true" set:html={inner}
/>
