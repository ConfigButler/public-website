---
import type { IntentExample } from '../content/home';

interface Props {
	examples: readonly IntentExample[];
}

const { examples } = Astro.props;
const initialExample = examples[0];
---

<section class="intent-demo" id="intent-to-commit" aria-labelledby="intent-demo-title" data-intent-demo>
	<div class="intent-demo__header">
		<div>
			<p class="section-kicker">Intent to Commit</p>
			<h2 id="intent-demo-title">A safer front door for configuration</h2>
		</div>
		<div class="intent-demo__tabs" role="tablist" aria-label="Intent examples">
			{examples.map((example, index) => (
				<button
					class={`intent-demo__tab ${index === 0 ? 'is-active' : ''}`}
					type="button"
					role="tab"
					aria-selected={index === 0 ? 'true' : 'false'}
					data-intent-tab
					data-index={index}
				>
					{example.label}
				</button>
			))}
		</div>
	</div>

	<div class="intent-demo__sources" aria-label="Input sources">
		<span class="source-pill is-active" data-source-pill="human">Human</span>
		<span class="source-pill" data-source-pill="agent">AI agent</span>
		<span class="source-pill" data-source-pill="automation">Automation</span>
	</div>

	<div class="intent-demo__grid">
		<article class="demo-card demo-card--request">
			<div class="demo-card__label">Intent</div>
			<div class="demo-card__title" data-source-label>{initialExample.sourceLabel}</div>
			<pre class="code-block"><code data-request-code>{initialExample.request}</code></pre>
		</article>

		<article class="demo-card demo-card--control-plane">
			<div class="demo-card__label">ConfigButler API + GUI</div>
			<h3 class="demo-card__headline">Typed intent + validation + policy</h3>
			<ul class="validation-list" data-validation-list>
				{initialExample.validations.map((item) => (
					<li>{item}</li>
				))}
			</ul>
			<p class="demo-card__note">Accepted requests become Git commits or pull requests that fit the workflow you already run.</p>
		</article>

		<article class="demo-card demo-card--outcome">
			<div class="demo-card__label">Git-backed outcome</div>
			<pre class="code-block code-block--yaml"><code data-output-code>{initialExample.output}</code></pre>
			<div class="commit-card">
				<div class="commit-card__row">
					<span class="commit-card__meta">commit</span>
					<span class="commit-card__hash" data-commit-hash>{initialExample.commitHash}</span>
				</div>
				<p class="commit-card__message" data-commit-message>{initialExample.commitMessage}</p>
				<p class="commit-card__path" data-commit-path>{initialExample.commitPath}</p>
				<div class="status-chip" data-status>{initialExample.status}</div>
				<p class="commit-card__note" data-status-note>{initialExample.statusNote}</p>
			</div>
		</article>
	</div>
</section>

<script define:vars={{ examples }}>
	const root = document.querySelector('[data-intent-demo]');

	if (root) {
		const tabs = Array.from(root.querySelectorAll('[data-intent-tab]'));
		const requestCode = root.querySelector('[data-request-code]');
		const outputCode = root.querySelector('[data-output-code]');
		const sourceLabel = root.querySelector('[data-source-label]');
		const validationList = root.querySelector('[data-validation-list]');
		const commitHash = root.querySelector('[data-commit-hash]');
		const commitMessage = root.querySelector('[data-commit-message]');
		const commitPath = root.querySelector('[data-commit-path]');
		const status = root.querySelector('[data-status]');
		const statusNote = root.querySelector('[data-status-note]');
		const sourcePills = Array.from(root.querySelectorAll('[data-source-pill]'));

		let activeIndex = 0;
		let intervalId;

		const render = (index) => {
			const example = examples[index];
			activeIndex = index;

			tabs.forEach((tab, tabIndex) => {
				const isActive = tabIndex === index;
				tab.classList.toggle('is-active', isActive);
				tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
			});

			sourcePills.forEach((pill) => {
				pill.classList.toggle('is-active', pill.dataset.sourcePill === example.source);
			});

			if (requestCode) requestCode.textContent = example.request;
			if (outputCode) outputCode.textContent = example.output;
			if (sourceLabel) sourceLabel.textContent = example.sourceLabel;
			if (commitHash) commitHash.textContent = example.commitHash;
			if (commitMessage) commitMessage.textContent = example.commitMessage;
			if (commitPath) commitPath.textContent = example.commitPath;
			if (status) status.textContent = example.status;
			if (statusNote) statusNote.textContent = example.statusNote;

			if (validationList) {
				validationList.innerHTML = '';
				example.validations.forEach((item) => {
					const li = document.createElement('li');
					li.textContent = item;
					validationList.appendChild(li);
				});
			}
		};

		const restartAutoplay = () => {
			window.clearInterval(intervalId);
			intervalId = window.setInterval(() => {
				const nextIndex = (activeIndex + 1) % examples.length;
				render(nextIndex);
			}, 4800);
		};

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const index = Number(tab.dataset.index || 0);
				render(index);
				restartAutoplay();
			});
		});

		render(0);
		restartAutoplay();
	}
</script>
